{% extends 'base.html.twig' %}

{% block title %}{{ 'polls.slots.title' | trans }}{% endblock %}

{% block body %}
    <div class="wrapper wrapper--small wrapper--center flow flow--larger">
        <div class="flow">
            <h1>
                {{ 'polls.slots.title' | trans }}
            </h1>

            {{ include('polls/_flow_steps.html.twig', { step: 'slots' }) }}

            <p>
                {{ 'polls.slots.help' | trans }}
            </p>
        </div>

        {{ form_start(form) }}
            {{ form_errors(form) }}

            <div class="text--center">
                <button
                    type="button"
                    data-controller="modal-opener"
                    data-action="modal-opener#copy"
                    data-modal-opener-selector-value="#modal-slots-applier"
                >
                    {{ icon('clone') }}
                    {{ 'polls.slots.same_slots.apply' | trans }}
                </button>
            </div>

            {% for date in form.dates %}
                <fieldset class="panel panel--primary panel--rounded">
                    <legend>{{ date.vars.data.value | dateTrans('EEEE d MMMM yyyy') }}</legend>

                    <div
                        class="flow flow--ignore-empty"
                        data-controller="collection"
						{# fcw: 2026-03-08: Mit Gemini erweitert: https://gemini.google.com/app/8e6cc1756142038f #}
						{# ew6: Pollaris: Individuelle Terminlimits hinzufügen #}
                        {# fcw: vorher: data-collection-index-value="{{ date.proposals|length > 0 ? date.proposals|last.vars.name + 1 : 0 }}" #}
                        data-collection-index-value="{{ date.proposals|length }}"
                        data-item="date-collection"
                    >
                        <div data-collection-target="container" class="flow">
                            {% for proposal in date.proposals %}
                                <div class="flow flow--small" data-item="element">
                                    {{ form_label(proposal.label) }}
                                    {{ form_errors(proposal.label) }}

                                    <div class="cols cols--always cols--gap">
                                        {{ form_widget(proposal.label) }}
                                        {# fcw: 2026-03-08: Mit Gemini erweitert: https://gemini.google.com/app/8e6cc1756142038f #}
                                        {# ew6: Pollaris: Individuelle Terminlimits hinzufügen #}
                                        {# NEU: Das Limit-Feld direkt neben oder unter dem Slot #}
                                        {{ form_widget(proposal.maxVotes, {
                                            'attr': {
                                                'placeholder': 'forms.proposal_type.max_votes.placeholder'|trans,
                                                'style': 'width: 80px;',
                                                'title': 'forms.proposal_type.max_votes.slot_title'|trans
                                            }
                                         }) }}

                                        <button
                                            type="button"
                                            class="button--ghost button--small"
                                            data-action="collection#removeElement"
                                        >
                                            {{ icon('trash') }}

                                            <span class="sr-only">
                                                {{ 'forms.poll_slots_form.remove_slot' | trans }}
                                            </span>
                                        </button>
                                    </div>
                                    {# fcw: 2026-03-08: Gemini: Fehler für das Limit-Feld anzeigen, falls die Validierung fehlschlägt #}
                                    {{ form_errors(proposal.maxVotes) }}
                                </div>
                            {% endfor %}
                        </div>

                        <button
                            type="button"
                            class="button--menuitem"
                            data-action="collection#addElement"
                        >
                            {{ icon('circle-plus') }}

                            {{ 'forms.poll_slots_form.add_slot' | trans }}
                        </button>

                        <template data-collection-target="prototype">
                            <div class="flow flow--small" data-item="element">
                                {{ form_label(date.proposals.vars.prototype.label) }}

                                {{ form_errors(date.proposals.vars.prototype.label) }}

                                <div class="cols cols--always cols--gap">
                                    {{ form_widget(date.proposals.vars.prototype.label) }}
                                    {# fcw: 2026-03-08: Mit Gemini erweitert: https://gemini.google.com/app/8e6cc1756142038f #}
                                    {# ew6: Pollaris: Individuelle Terminlimits hinzufügen #}
                                    {# NEU: Das Limit-Feld im Prototyp #}

            {% if date.proposals.vars.prototype.maxVotes is defined %}
                {{ form_widget(date.proposals.vars.prototype.maxVotes, {
                    'attr': {
                        'placeholder': 'forms.proposal_type.max_votes.placeholder'|trans,
                        'style': 'width: 80px;'
                    }
                }) }}
            {% endif %}


                                    <button
                                        type="button"
                                        class="button--ghost button--small"
                                        data-action="collection#removeElement"
                                    >
                                        {{ icon('trash') }}

                                        <span class="sr-only">
                                            {{ 'forms.poll_slots_form.remove_slot' | trans }}
                                        </span>
                                    </button>
                                </div>
                                {# fcw: 2026-03-08: Mit Gemini erweitert: https://gemini.google.com/app/8e6cc1756142038f #}
                                {# ew6: Pollaris: Individuelle Terminlimits hinzufügen #}
        {% if date.proposals.vars.prototype.maxVotes is defined %}
            {{ form_errors(date.proposals.vars.prototype.maxVotes) }}
        {% endif %}
                            </div>
                        </template>
                    </div>
                </fieldset>
            {% endfor %}
            {# Buttons für "Zurück" und "Weiter" #}
            {{ include('polls/_flow_actions.html.twig', { step: 'slots' }) }}
            {# KORREKTUR: Wir rendern das CSRF-Token explizit. 
                Das verhindert den "Ungültiges CSRF-Token" Fehler, 
                auch wenn render_rest auf false steht.
            #}
            {% if form._token is defined %}
                {{ form_widget(form._token) }}
            {% endif %}
            {#
                render_rest: false sorgt dafür, dass Symfony nicht
                versucht, irgendwelche "vergessenen" Felder am Ende
                wild in das Layout zu klatschen.
                vorher: {{ form_end(form) }}
            #}
            {{ form_end(form, {'render_rest': false}) }}

        {{ include('polls/_slots_applier_modal.html.twig') }}
    </div>
{% endblock %}
