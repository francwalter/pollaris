{# Optionale Anzeige direkt in der Liste, Datei komplett ersetzt von Gemini, .bak erstellt davor #}
{# ToDo: "Dienst", "Dienste", "Voll" usw noch lokalisieren #}

{% set preferredChoices = poll.preferredChoices %}
{% set displayMode = poll.type %}

<div class="flow flow--large">
    {% if displayMode == 'classic' %}
        {# fcw: 2026-03-10: Sortierungsfilter, nach der verkehrt herum angelegten Sedrun Umfrage einbauen #}
        {# {% for proposal in proposals | sort((a, b) => a.id <=> b.id) %} #}
        {% for proposal in proposals %}
            <div class="panel panel--primary panel--rounded">
                {{ include('proposals/_proposal.html.twig', {
                    proposal: proposal,
                    isPreferred: preferredChoices and proposal in preferredChoices,
                    voteForm: voteForm,
                    myVote: myVote,
                }) }}
                
                {# Optionale Anzeige direkt in der Liste #}
                {% if proposal.maxVotes %}
                    {% set jaStimmen = proposal.countAnswers('yes') %}
                    {% set freiePlaetze = proposal.maxVotes - jaStimmen %}
                    <div style="padding: 0 1rem 1rem; margin-top: 1rem; font-size: 0.9em; color: red;">
                        {% if freiePlaetze <= 0 %}
                            <span class="badge badge--danger">{{ 'polls.proposals.max_votes.all_taken'|trans }}</span>
                        {% else %}
                            <span class="badge badge--success">{{ 'polls.proposals.max_votes.slots_remaining'|trans({count: freiePlaetze}) }}</span>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    {% elseif displayMode == 'date' %}
        {% for dateAndProposals in datesAndProposals %}
            {% set date = dateAndProposals[0] %}

            {# fcw: 2026-03-10: Sortierungsfilter, nach der verkehrt herum angelegten Sedrun Umfrage einbauen #}
            {# {% set proposals = dateAndProposals[1] | sort((a, b) => a.id <=> b.id) %} #}
            {% set proposals = dateAndProposals[1] %}

            <fieldset class="panel panel--primary panel--rounded panel--date flow">
                <div class="panel--date__legend">
                    <legend>{{ date.value | dateTrans('EEEE d MMMM yyyy') }}</legend>
                </div>

                {% for proposal in proposals %}
                    <div class="flow">
                        {{ include('proposals/_proposal.html.twig', {
                            proposal: proposal,
                            isPreferred: preferredChoices and proposal in preferredChoices,
                            voteForm: voteForm,
                            myVote: myVote,
                        }) }}
                        
                        {% if proposal.maxVotes %}
                            {% set jaStimmen = proposal.countAnswers('yes') %}
                            {% set freiePlaetze = proposal.maxVotes - jaStimmen %}
                            <div style="padding: 0 1rem 1rem; margin-top: -1rem; font-size: 0.85em;">
                                <b>{{ 'polls.proposals.max_votes.availability'|trans }}</b>
                                {% if freiePlaetze <= 0 %}
                                    <span style="color: #d9534f;">{{ 'polls.proposals.max_votes.full'|trans }}</span>
                                {% else %}
                                    <span style="color: #5cb85c;">{{ 'polls.proposals.max_votes.slots_free'|trans({count: freiePlaetze}) }}</span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </fieldset>
        {% endfor %}
    {% endif %}
</div>