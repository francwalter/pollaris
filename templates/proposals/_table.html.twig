{# fcw: 2026-03-10: ToDo: "Dienst", "Dienste", "Voll" usw noch lokalisieren #}

{% set preferredChoices = poll.preferredChoices %}
{% set displayMode = poll.type %}

{% set votes = [] %}
{% if canViewResults(poll) %}
    {% set votes = poll.votes %}
{% elseif myVote %}
    {% set votes = [myVote] %}
{% endif %}

<div class="scrollbox" data-controller="scrollbox">
    <div
        class="proposals-table-container"
        data-controller="proposals-table"
        data-scrollbox-target="scroller"
    >
        <table class="proposals-table panel panel--white panel--rounded">
            {% if displayMode == 'classic' %}
                <tr>
                    <td class="proposals-table__sticky-cell"></td>

                    {# fcw: 2026-03-10: Sortierungsfilter #}
                    {# fcw: 2026-03-10: Sortierungsfilter, nach der verkehrt herum angelegten Sedrun Umfrage einbauen #}
                    {# {% for proposal in (proposals|default([])) | sort((a, b) => a.id <=> b.id) %} #}
                    {% for proposal in proposals %}
                        <th
                            {% if loop.first %}data-scrollbox-target="leftObserver"{% endif %}
                            {% if loop.last %}data-scrollbox-target="rightObserver"{% endif %}
                        >
                            <span class="proposal__label">{{ proposal.label }}</span>

                            {# fcw: 2026-03-10: Mit Gemini erweitert: https://gemini.google.com/app/8e6cc1756142038f #}
                            {# ew6: Pollaris: Individuelle Terminlimits hinzufügen #}
                            {# NEU: Platzanzeige #}
                            {% if proposal.maxVotes %}
                                {% set jaStimmen = proposal.countAnswers('yes') %}
                                {% set freiePlaetze = proposal.maxVotes - jaStimmen %}
                                <div style="font-size: 0.75rem; font-weight: normal; margin-top: 5px;">
                                    {% if freiePlaetze <= 0 %}
                                        <b style="color: #d9534f;">Ausgebucht</b>
                                    {% elseif freiePlaetze == 1 %}
                                        <span style="color: #5cb85c;">1 Dienst frei</span>
                                    {% else %}
                                        <span style="color: #5cb85c;">{{ freiePlaetze }} Dienste frei</span>
                                    {% endif %}
                                </div>
                            {% endif %}

                        </th>
                    {% endfor %}
                </tr>
            {% elseif displayMode == 'date' %}
                <tr>
                    <td class="proposals-table__sticky-cell"></td>

                    {% for dateAndProposals in datesAndProposals %}
                        {% set date = dateAndProposals[0] %}
                        {% set dateProposals = dateAndProposals[1] %}
                        {# fcw: 2026-03-10: Sortierungsfilter, nach der verkehrt herum angelegten Sedrun Umfrage einbauen #}
                        {# {% for proposal in (dateProposals|default([])) | sort((a, b) => a.id <=> b.id) %} #}
                        {% for proposal in dateProposals %}

                            <th
                                {% if loop.parent.loop.first and loop.first %}data-scrollbox-target="leftObserver"{% endif %}
                                {% if loop.parent.loop.last and loop.last %}data-scrollbox-target="rightObserver"{% endif %}
                            >
                                <span class="proposal__day-week">{{ date.value | dateTrans('EEE') }}</span>
                                <span class="proposal__day-month">{{ date.value | dateTrans('d') }}</span>
                                <span class="proposal__month">{{ date.value | dateTrans('MMM y') }}</span>
                                <span class="proposal__label">{{ proposal.label }}</span>

                                {# fcw: 2026-03-10: Mit Gemini erweitert: https://gemini.google.com/app/8e6cc1756142038f #}
                                {# ew6: Pollaris: Individuelle Terminlimits hinzufügen #}
                                {# NEU: Platzanzeige #}
                                {% if proposal.maxVotes %}
                                    {% set jaStimmen = proposal.countAnswers('yes') %}
                                    {% set freiePlaetze = proposal.maxVotes - jaStimmen %}
                                    <div style="font-size: 0.75rem; font-weight: normal; margin-top: 5px;">
                                        {% if freiePlaetze <= 0 %}
                                            <b style="color: #d9534f;">Voll</b>
                                        {% else %}
                                            <span style="color: #5cb85c;">{{ freiePlaetze }} frei</span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </th>
                        {% endfor %}
                    {% endfor %}
                </tr>
            {% endif %}

            {% if voteForm %}
                <tr class="no-print">
                    <th class="proposals-table__sticky-cell">
                        <div class="proposals-table__author proposals-table__author--new">
                            {{ 'polls.votes.yours' | trans }}
                        </div>
                    </th>

                    {% for proposal in proposals %}
                        <td data-poll-view-target="tableVoteSlot" data-proposal="{{ proposal.id }}">
                        </td>
                    {% endfor %}
                </tr>
            {% endif %}

            {% for vote in votes %}
                <tr>
                    <th class="proposals-table__sticky-cell">
                        <div class="proposals-table__author">
                            {{ vote.authorName }}
                        </div>
                    </th>

                    {% for proposal in proposals %}
                        {% set answer = vote.answerForProposal(proposal) %}

                        <td class="text--center">
                            {% if answer.value == 'yes' %}
                                <span class="vote vote--yes">
                                    {{ icon('square-check') }}

                                    <span class="sr-only">
                                        {{ 'polls.votes.yes' | trans }}
                                    </span>
                                </span>
                            {% elseif answer.value == 'no' %}
                                <span class="vote vote--no">
                                    {{ icon('square-xmark') }}

                                    <span class="sr-only">
                                        {{ 'polls.votes.no' | trans }}
                                    </span>
                                </span>
                            {% elseif answer.value == 'maybe' %}
                                <span class="vote vote--maybe">
                                    {{ icon('square-minus') }}

                                    <span class="sr-only">
                                        {{ 'polls.votes.maybe' | trans }}
                                    </span>
                                </span>
                            {% endif %}
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}

            {% if canViewResults(poll) and votes is not empty %}
                <tr>
                    <th class="proposals-table__sticky-cell">
                        <div class="proposals-table__sum">
                            {{ 'polls.votes.sum' | trans }}
                        </div>
                    </th>

                    {% for proposal in proposals %}
                        {% set countYes = proposal.countAnswers('yes') %}
                        {% set countMaybe = proposal.countAnswers('maybe') %}
                        {% set isPreferred = preferredChoices and proposal in preferredChoices %}

                        <td class="text--center{% if isPreferred %} text--success text--bold{% endif %}">
                            {% if isPreferred %}
                            {# fcw: 2026-03-10: hier wird der beste Vorschlag mit einem Sternchen versehen, braucht man nicht #}
                                {# {{ icon('star') }} #}
                            {% endif %}

                            {% if countYes > 0 %}
                                {{ countYes }}

                                <span class="sr-only">
                                    {{ 'polls.votes.yes' | trans }}
                                </span>
                            {% endif %}

                            {% if countMaybe > 0 %}
                                <span class="text--secondary text--small">
                                    {{ 'polls.votes.maybe.count_alt' | trans({ count: countMaybe }) }}
                                </span>
                            {% endif %}

                            {% if isPreferred %}
                                <span class="sr-only">
                                    {{ 'polls.proposals.best' | trans }}
                                </span>
                            {% endif %}
                        </td>
                    {% endfor %}
                </tr>
            {% endif %}
        </table>
    </div>
</div>
