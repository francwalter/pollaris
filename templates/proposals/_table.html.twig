{# fcw: 2026-03-10: ToDo: "Dienst", "Dienste", "Voll" usw noch lokalisieren #}

{% set preferredChoices = poll.preferredChoices %}
{% set displayMode = poll.type %}

{% set votes = [] %}
{% if canViewResults(poll) %}
    {% set votes = poll.votes %}
{% elseif myVote %}
    {% set votes = [myVote] %}
{% endif %}

<div class="scrollbox" data-controller="scrollbox">
    <div
        class="proposals-table-container"
        data-controller="proposals-table"
        data-scrollbox-target="scroller"
    >
        <table class="proposals-table panel panel--white panel--rounded">
            <thead>
            {% if displayMode == 'classic' %}
                <tr>
                    <td class="proposals-table__sticky-cell"></td>

                    {% for proposal in proposals %}
                        <th
                            {% if loop.first %}data-scrollbox-target="leftObserver"{% endif %}
                            {% if loop.last %}data-scrollbox-target="rightObserver"{% endif %}
                        >
                            <span class="proposal__label">{{ proposal.label }}</span>

                            {% if proposal.maxVotes %}
                                {% set yesCount = proposal.countAnswers('yes') %}
                                {% set freeSlots = proposal.maxVotes - yesCount %}
                                <div style="font-size: 0.75rem; font-weight: normal; margin-top: 5px;">
                                    {% if freeSlots <= 0 %}
                                        <b style="color: #d9534f;">{{ 'polls.proposals.max_votes.full'|trans }}</b>
                                    {% else %}
                                        <span style="color: #5cb85c;">{{ 'polls.proposals.max_votes.slots_free'|trans({count: freeSlots}) }}</span>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </th>
                    {% endfor %}

                    <th class="text--center user-total-yes" style="width: 50px;">
                        {{ 'polls.votes.sum'|trans }}
                    </th>
                </tr>
            {% elseif displayMode == 'date' %}
                <tr>
                    <td class="proposals-table__sticky-cell"></td>

                    {% for dateAndProposals in datesAndProposals %}
                        {% set date = dateAndProposals[0] %}
                        {% set dateProposals = dateAndProposals[1] %}

                        {% for proposal in dateProposals %}
                            <th
                                {% if loop.first %}data-scrollbox-target="leftObserver"{% endif %}
                                {% if loop.last %}data-scrollbox-target="rightObserver"{% endif %}
                                scope="col"
                            >
                                <span class="proposal__day-week">{{ date.value | dateTrans('EEE') }}</span>
                                <span class="proposal__day-month">{{ date.value | dateTrans('d') }}</span>
                                <span class="proposal__month">{{ date.value | dateTrans('MMM y') }}</span>
                                <span class="proposal__label">{{ proposal.label }}</span>

                                {% if proposal.maxVotes %}
                                    {% set yesCount = proposal.countAnswers('yes') %}
                                    {% set freeSlots = proposal.maxVotes - yesCount %}
                                    <div style="font-size: 0.75rem; font-weight: normal; margin-top: 5px;">
                                        {% if freeSlots <= 0 %}
                                            <b style="color: #d9534f;">{{ 'polls.proposals.max_votes.full'|trans }}</b>
                                        {% else %}
                                            <span style="color: #5cb85c;">{{ 'polls.proposals.max_votes.slots_free'|trans({count: freeSlots}) }}</span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </th>
                        {% endfor %}
                    {% endfor %}

                    <th class="text--center user-total-yes" style="width: 50px;">
                        {{ 'polls.votes.sum'|trans }}
                    </th>
                </tr>
            {% endif %}
            </thead>

            <tbody>
            {% if voteForm %}
                {% set tableColumnsCount = proposals|length + 2 %}
                <tr class="no-print">
                    <th class="proposals-table__sticky-cell">
                        <div class="proposals-table__author proposals-table__author--new">
                            {{ 'polls.votes.yours' | trans }}
                        </div>
                    </th>

                    {% for proposal in proposals %}
                        <td data-poll-view-target="tableVoteSlot" data-proposal="{{ proposal.id }}"></td>
                    {% endfor %}

                    <td class="text--center user-total-yes"></td>
                </tr>

                {% set shouldRenderAuthorName = not voteForm.authorName.vars.rendered %}
                {% set shouldRenderPassword = voteForm.password is defined and not voteForm.password.vars.rendered %}
                {% set shouldRenderSubmit = not voteForm.submit.vars.rendered %}
                {% if shouldRenderAuthorName or shouldRenderPassword or shouldRenderSubmit %}
                    <tr class="no-print">
                        <td colspan="{{ tableColumnsCount }}">
                            {% if shouldRenderAuthorName or shouldRenderPassword %}
                                <div class="panel panel--primary panel--rounded flow show_author">
                                    {% if shouldRenderAuthorName %}
                                        {{ form_row(voteForm.authorName) }}
                                    {% endif %}

                                    {% if shouldRenderPassword %}
                                        {{ form_row(voteForm.password) }}
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if shouldRenderSubmit %}
                                <div class="poll-submit-wrapper__actions__inner cols cols--always cols--gap cols--center">
                                    <p
                                        id="vote-help"
                                        data-form-vote-validation-target="voteHelp"
                                        class="poll-submit-indication"
                                    >
                                        {{- 'forms.vote_form.required_choice' | trans -}}
                                    </p>

                                    {{ form_row(voteForm.submit) }}
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% endif %}
            {% endif %}

            {% set totalYes = 0 %}

            {% for vote in votes %}
                {% set userTotalYes = 0 %}
                <tr>
                    <th class="proposals-table__sticky-cell">
                        <div class="proposals-table__author">
                            {{ vote.authorName }}
                        </div>
                    </th>

                    {% for proposal in proposals %}
                        {% set answer = vote.answerForProposal(proposal) %}

                        <td class="text--center">
                            {% if answer and answer.value == 'yes' %}
                                {% set userTotalYes = userTotalYes + 1 %}
                                <span class="vote vote--yes">
                                    {{ icon('square-check') }}
                                    <span class="sr-only">{{ 'polls.votes.yes' | trans }}</span>
                                </span>
                            {% elseif answer and answer.value == 'no' %}
                                <span class="vote vote--no">
                                    {{ icon('square-xmark') }}
                                    <span class="sr-only">{{ 'polls.votes.no' | trans }}</span>
                                </span>
                            {% elseif answer and answer.value == 'maybe' %}
                                <span class="vote vote--maybe">
                                    {{ icon('square-minus') }}
                                    <span class="sr-only">{{ 'polls.votes.maybe' | trans }}</span>
                                </span>
                            {% endif %}
                        </td>
                    {% endfor %}

                    <td class="text--center text--bold user-total-yes">
                        {{ userTotalYes }}
                    </td>
                </tr>

                {% set totalYes = totalYes + userTotalYes %}
            {% endfor %}

            {% if canViewResults(poll) and votes is not empty %}
                <tr>
                    <th class="proposals-table__sticky-cell">
                        <div class="proposals-table__sum">
                            {{ 'polls.votes.sum' | trans }}
                        </div>
                    </th>

                    {% for proposal in proposals %}
                        {% set countYes = proposal.countAnswers('yes') %}
                        {% set countMaybe = proposal.countAnswers('maybe') %}
                        {% set isPreferred = proposal.id in preferredChoices %}

                        <td class="text--center{% if isPreferred %} text--success text--bold{% endif %}">
                            {{ 'polls.votes.yes.count_alt' | trans({ count: countYes }) }}

                            {% if countMaybe > 0 %}
                                <span class="text--secondary text--small">
                                    {{ 'polls.votes.maybe.count_alt' | trans({ count: countMaybe }) }}
                                </span>
                            {% endif %}

                            {% if isPreferred %}
                                <span class="sr-only">
                                    {{ 'polls.proposals.best' | trans }}
                                </span>
                            {% endif %}
                        </td>
                    {% endfor %}

                    <td class="text--center text--bold total-yes">
                        {{ totalYes }}
                    </td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    </div>
</div>
